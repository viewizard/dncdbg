---
Checks: >
  clang-analyzer-*,
  performance-*,
  portability-*,
  cert-*,
  -cert-dcl03-c, # Alias of misc-static-assert
  bugprone-*,
  -bugprone-assignment-in-if-condition,
  -bugprone-easily-swappable-parameters,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  modernize-*,
  -modernize-use-trailing-return-type,
  misc-*,
  -misc-static-assert, # Gives false positives on all asserts: https://github.com/llvm/llvm-project/issues/213560
  readability-*,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-duplicate-include,
  -readability-else-after-return,
  -readability-trailing-comma
CheckOptions:
  misc-include-cleaner.MissingIncludes: 'false'
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: 'true'
WarningsAsErrors: "*"
HeaderFilterRegex: 'src/'
ExcludeHeaderFilterRegex: 'third-party/'
...
